# Development build of sfe (Simple File Explorer) from this checkout,
# uncommitted changes included. The released version is ../sfe/PKGBUILD;
# the two packages replace each other.
#
# Build & install from this directory:
#   makepkg -si
#
# Dependencies are annotated with the source module that needs them.
# Keep this list in sync with ../sfe/PKGBUILD whenever a module starts using
# a new library or tool.

pkgname=sfe-dev
pkgver=1.0.0
pkgrel=1
pkgdesc='Simple File Explorer - a minimal, Wayland-native GTK3 file manager (development build)'
arch=('x86_64' 'aarch64' 'i686' 'armv7h')
url='https://github.com/dakata1337/sfe'
license=('MIT')

depends=(
  'glib2'             # everything (GIO: files, monitors, D-Bus)
  'gtk3'              # UI toolkit (window.c, pane.c, theme.c, ...)
  'cairo'             # HiDPI icon surfaces (icons.c, dirmodel.c)
  'gdk-pixbuf2'       # image loading / image thumbnails (thumbs.c)
  'hicolor-icon-theme' # fallback icon theme; holds sfe's logo (data/icons, sfe.desktop)
  'shared-mime-info'  # file type detection and descriptions (dirmodel.c)
  'udisks2'           # unprivileged mounting over D-Bus (devices.c)
  'polkit'            # authorizes udisks2 mount requests (devices.c)
  'xdg-utils'         # xdg-open, the default opener (opener.c)
  'ffmpeg'            # video thumbnail fallback (thumbs.c)
)
optdepends=(
  'polkit-agent: password prompt for mounting internal drives (e.g. hyprpolkitagent, polkit-gnome)'
  'ffmpegthumbnailer: faster, higher-quality video thumbnails'
  'libarchive: Extract Here (tar, zip, 7z, rar, iso) and Compress (zip, tar.*, 7z) with bsdtar (archive.c)'
  'unzip: Extract Here for zip without bsdtar (archive.c)'
  'zip: Compress to zip without bsdtar (archive.c)'
  '7zip: Extract Here for 7z and rar, Compress to 7z and zip, without bsdtar (archive.c)'
  'unrar: Extract Here for rar (archive.c)'
  'libnotify: notify-send for config file errors (app.c; GNotification otherwise)'
  'webp-pixbuf-loader: WebP image thumbnails'
  'libheif: HEIF/AVIF image thumbnails'
  'ntfs-3g: mount NTFS drives'
  'exfatprogs: exFAT drive support'
  'dosfstools: FAT drive support'
)
provides=('sfe')
conflicts=('sfe')
makedepends=('meson' 'ninja' 'git')
# check(): desktop-file-validate (desktop-file-utils) and appstreamcli (appstream)
# validate the data files when they are installed.
checkdepends=()

source=()
sha256sums=()

# The project root, three levels above this PKGBUILD.
_root="$(realpath "${startdir}/../../..")"

# 1.0.0.r12.gabc1234: the last release tag, commits since, the commit.
pkgver() {
  cd "${_root}"
  if git describe --long --tags --match 'v*' >/dev/null 2>&1; then
    git describe --long --tags --match 'v*' | sed -E 's/^v//; s/-([0-9]+)-g/.r\1.g/'
  else
    local version
    version=$(sed -nE "s/^\s*version:\s*'([^']+)'.*/\1/p" meson.build | head -n1)
    printf '%s.r%s.g%s' "${version}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

build() {
  arch-meson "${_root}" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "${pkgdir}"
  install -Dm644 "${_root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${_root}/thirdparty/tomlc17/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/tomlc17-LICENSE"
}
