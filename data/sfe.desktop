[Desktop Entry]
Type=Application
Name=Simple File Explorer
GenericName=File Manager
Comment=Browse and manage files
Exec=sfe %U
Icon=sfe
Terminal=false
StartupNotify=true
Categories=GTK;Core;System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=folder;manager;explore;disk;filesystem;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=sfe
